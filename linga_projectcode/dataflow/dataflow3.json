{
	"name": "dataflow3",
	"properties": {
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "DelimitedText4",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "DelimitedText5",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "selectsale"
				},
				{
					"name": "filtersale"
				},
				{
					"name": "splitsale"
				},
				{
					"name": "aggregate1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          Quantity as integer,",
				"          {Unit Price} as integer,",
				"          Country as string,",
				"          Product as string,",
				"          {Order ID} as string,",
				"          {Order Date} as string,",
				"          Category as string,",
				"          {Total Sales} as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     ignoreNoFilesFound: false,",
				"     partitionBy('hash', 1)) ~> source1",
				"source1 select(mapColumn(",
				"          Quantity,",
				"          {Unit Price},",
				"          Country,",
				"          Product,",
				"          {Order ID},",
				"          {Total Sales}",
				"     ),",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> selectsale",
				"selectsale filter({Order ID}!='ORD1002') ~> filtersale",
				"filtersale split(Country=='India',",
				"     Country=='USA',",
				"     Country=='other',",
				"     disjoint: false,",
				"     partitionBy('hash', 1)) ~> splitsale@(India, USA, other)",
				"splitsale@India aggregate(groupBy({Order ID}),",
				"     {Unit Price} = sum({Unit Price}*Quantity)) ~> aggregate1",
				"aggregate1 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     umask: 0022,",
				"     preCommands: [],",
				"     postCommands: [],",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true) ~> sink1"
			]
		}
	}
}