						"source(output(",
						"          Employee_ID as integer,",
						"          First_Name as string,",
						"          Salary as integer,",
						"          Location as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     ignoreNoFilesFound: false,",
						"     partitionBy('hash', 1)) ~> sourceCSV",
						"source(output(",
						"          SurrKey as integer,",
						"          Emp_ID as integer,",
						"          FName as string,",
						"          Salary as integer,",
						"          Loc as string,",
						"          Is_Active as integer",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table',",
						"     partitionBy('hash', 1)) ~> sourceDatabase",
						"sourceCSV derive(HashCode = md5(Employee_ID,First_Name,Salary,Location),",
						"     partitionBy('hash', 1)) ~> derivedColumnSRC",
						"sourceDatabase derive(HashCode = md5(Emp_ID,FName,Salary,Loc),",
						"     partitionBy('hash', 1)) ~> derivedColumnDATABASE",
						"derivedColumnSRC, derivedColumnDATABASE exists(derivedColumnSRC@HashCode == derivedColumnDATABASE@HashCode,",
						"     negate:true,",
						"     partitionBy('hash', 1),",
						"     broadcast: 'auto')~> existsHCsrc",
						"existsHCsrc derive(Is_Active = 1,",
						"     partitionBy('hash', 1)) ~> derivedColumnACTIVE",
